{
  "name": "Task_7",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/visual-service": "^9.0.0",
    "allure-commandline": "^2.34.1",
    "dotenv": "^17.2.3"
  },
  "scripts": {
    "test": "npx wdio run wdio.conf.js",
    "test:chrome": "npx wdio run wdio.conf.js --capabilities chrome",
    "test:firefox": "npx wdio run wdio.conf.js --capabilities firefox",
    "test:edge": "npx wdio run wdio.conf.js --capabilities MicrosoftEdge",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "report:deploy": "npm run report:generate && gh-pages -d allure-report -b test-results"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0"
  }
}
